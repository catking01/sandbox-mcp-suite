{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox-mcp.local/schemas/TASK_CONTRACT.schema.json",
  "title": "Sandbox MCP Web Pro Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "branch",
    "snapshot",
    "planner",
    "goal",
    "non_goals",
    "allowed_paths",
    "forbidden_paths",
    "validation_commands",
    "required_artifacts",
    "stop_conditions",
    "pass_gates",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": { "const": "web_pro_codex_task_contract.v1" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$" },
    "repository": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "context_mode"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "context_mode": { "type": "string", "minLength": 1 }
      }
    },
    "goal": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "allowed_paths": { "$ref": "#/$defs/pathList" },
    "forbidden_paths": { "$ref": "#/$defs/pathList" },
    "validation_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "pass_gates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "sandbox": { "const": "workspace-write" }
      }
    },
    "plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "repository", "base_commit", "tree_hash", "dirty", "status_hash"],
      "properties": {
        "snapshot_id": { "type": "string", "pattern": "^snapshot_[0-9a-f]{32}$" },
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree_hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" },
        "status_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(?:/|$)).+$"
      }
    }
  }
}
